# Farmazed API - Environment Variables
# Copy to .env for local dev (never commit .env)

# ── Configuración OBLIGATORIA (TAREA 40: el tracker valida esto al arrancar, ver
#    tracker/config.js — si falta algo, NO arranca y dice qué) ─────────────────────
# Sin proyecto/bucket por defecto: hay que nombrarlos.
FIREBASE_PROJECT_ID=farmazed
GCS_BUCKET=farmazed-docs

# Modo: en PRODUCCIÓN (Cloud Run define K_SERVICE; si no, NODE_ENV=production).
# En local el tracker SOLO arranca con los emuladores (FIRESTORE_EMULATOR_HOST, ver
# DEV_LOCAL.md): sin eso se niega, para no escribir en producción por accidente.
NODE_ENV=production

# Local dev: getSignedUrl() needs signing capability that plain
# `gcloud auth application-default login` (user OAuth) doesn't have —
# uploads work, but signed URLs fail with "Cannot sign data without
# `client_email`". Org policy (constraints/iam.disableServiceAccountKeyCreation)
# blocks downloadable SA keys, so GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json
# isn't an option here. Use impersonation instead (no key file, no env var
# needed — this updates ADC directly):
#   gcloud iam service-accounts add-iam-policy-binding \
#     farmazed-api-sa@farmazed.iam.gserviceaccount.com \
#     --member="user:<your-email>" --role="roles/iam.serviceAccountTokenCreator"
#   gcloud auth application-default login \
#     --impersonate-service-account=farmazed-api-sa@farmazed.iam.gserviceaccount.com

# Clave del MCP (Cowork). En producción: >= 32 caracteres, aleatoria
# (p. ej. `openssl rand -hex 32`). Nunca se versiona el valor real.
MCP_KEY=<generar-con-openssl-rand-hex-32>

# ── Pagos (PayPal) ────────────────────────────────────────────────────────────────
# En producción son obligatorios los 4 (si faltan, el tracker no arranca; NO cae al
# mock). PAYMENTS_PROVIDER=mock solo se permite fuera de producción (y el emulador
# ya usa el mock por defecto); con NODE_ENV=production es un error.
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=<client-id-de-la-app-paypal>
PAYPAL_CLIENT_SECRET=<secret-de-la-app-paypal>
PAYPAL_WEBHOOK_ID=<id-del-webhook-en-developer.paypal.com>
# PAYMENTS_PROVIDER=mock

# Orígenes https permitidos por CORS en producción (separados por coma). LISTA EXPLÍCITA, sin
# comodines de subdominio. Default: https://farmazed.com y https://www.farmazed.com.
# CORS_ORIGINS=https://farmazed.com,https://www.farmazed.com

# Saltos de proxy delante del tracker (rate limit por IP real). Default 1 = Cloud Run
# directo; poner 2 (o más) si hay un Load Balancer/CDN extra delante.
# TRUST_PROXY=1

# URLs
PORT=8080
REDIRECT_URL=https://farmazed.com

# Tarifario activo para resolverCategoriaPrecio() (tracker/routes/quotes.js,
# TAREA 23). Decision de NEGOCIO, no de entorno: dejar sin definir (o
# cualquier valor distinto de "24sep") usa el tarifario de siempre. Cambiar a
# "24sep" activa el tarifario del 24-sep (organizacion/10_DIFF_PRECIOS_24SEP.md)
# SOLO cuando Rick lo apruebe.
# PRICING_TABLE=24sep
