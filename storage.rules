// Reglas de PRODUCCIÓN (TAREA 40): deny-all. Los documentos se suben y se leen
// SOLO desde el tracker (Admin SDK / URLs firmadas de corta vida), que ignora estas
// reglas. Ningún cliente accede directo al bucket con las reglas de Firebase.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
