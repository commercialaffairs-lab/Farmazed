// Reglas SOLO para el emulador local (proyecto "demo-farmazed").
// NUNCA renombrar a "storage.rules" ni correr "firebase deploy" con este
// archivo — es intencionalmente abierto (allow if true) y abriría producción.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
